{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azizos",
  "version": "0.0.4",
  "identifier": "com.azizos.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Azizos",
        "width": 980,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "perMachine" }
    }
  }
}
