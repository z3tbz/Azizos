{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azizos",
  "version": "0.0.10",
  "identifier": "com.azizos.playbook",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aziz Playbook",
        "decorations": false,
        "theme": "Dark",
        "width": 700,
        "height": 500,
        "minWidth": 640,
        "minHeight": 460,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "perMachine" }
    }
  }
}
