        },
        {
            "type": "device",
            "op": "disable",
            "name": "Numeric Data Processor"
        },
        {
            "type": "device",
            "op": "disable",
            "name": "Communications Port (COM1)"
        },
        {
            "type": "device",
            "op": "disable",
            "name": "Microsoft GS Wavetable Synth"
        },
        {
            "type": "installer",
            "file": "vcpp.exe",
            "args": "/ai"
        },
        {
            "type": "bundled",
            "file": "Install-AzizOptimizer.ps1",
            "args": "",
            "runas": "user_elevated"
        }
