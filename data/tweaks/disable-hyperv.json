{
    "id":  "disable-hyperv",
    "name":  {
                 "ar":  "تعطيل Hyper-V و VBS",
                 "en":  "Disable Hyper-V and VBS"
             },
    "category":  "devices",
    "profiles":  [

                 ],
    "default":  false,
    "requires_reboot":  true,
    "risk":  "medium",
    "actions":  [
                    {
                        "type":  "bcd",
                        "args":  "/set {current} hypervisorlaunchtype off"
                    },
                    {
                        "type":  "bcd",
                        "args":  "/set {current} vm off"
                    },
                    {
                        "type":  "bcd",
                        "args":  "/set {current} vsmlaunchtype off"
                    },
                    {
                        "type":  "registry",
                        "op":  "set",
                        "hive":  "hklm",
                        "path":  "SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity",
                        "name":  "Enabled",
                        "kind":  "dword",
                        "data":  0
                    },
                    {
                        "type":  "registry",
                        "op":  "set",
                        "hive":  "hkcu",
                        "path":  "SOFTWARE\\Azizos",
                        "name":  "DisableHyperV",
                        "kind":  "dword",
                        "data":  1
                    }
                ],
    "description":  {
                        "ar":  "أداء ألعاب أفضل؛ الأجهزة الافتراضية وWSL2 تتوقف.",
                        "en":  "Better game performance; virtual machines and WSL2 stop working."
                    }
}